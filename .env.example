# OPENROUTER_API_KEY: Server-side API key for OpenRouter image generation, photo-to-cartoon, and live web trend scans.
# Add in Vercel Project Settings > Environment Variables (Production & Preview).
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Optional server-side Gemini API key (fallback AI provider).
GEMINI_API_KEY=""

# APPS_SCRIPT_WEBAPP_URL: Deployed Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
# Required on Vercel for persistent Google Sheets & Google Drive library storage across serverless invocations.
APPS_SCRIPT_WEBAPP_URL=""

# APPS_SCRIPT_SHARED_SECRET: Optional shared secret matching APPS_SCRIPT_SHARED_SECRET in Apps Script Properties.
APPS_SCRIPT_SHARED_SECRET=""

# CRON_SECRET: Optional Bearer secret for scheduled Vercel Cron requests to GET /api/jobs/run-next.
CRON_SECRET=""

# APP_URL: Deployed production URL (e.g. https://your-project.vercel.app).
APP_URL=""
